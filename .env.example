# ===== App =====
APP_ENV=dev
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ===== LLM Provider =====
# 选择: deepseek | qwen | openai
LLM_PROVIDER=openai

# 至少填一个, 其它可以留空
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI 槽位可复用任意 OpenAI 兼容 endpoint（如 MiniMax / DeepSeek / 本地 ollama）
# 把下面的占位符换成你自己的 key
OPENAI_API_KEY=your-openai-compatible-key-here
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M3
# 关掉 M3/M2 默认 thinking (否则思考过程会被塞进 .content 当正文)
OPENAI_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 本地面试演示：不调用外部 LLM，稳定跑通完整 RAG 问答链路。
PILKB_FAKE_LLM=1
# 本地环境的 transformers/tokenizers 版本不匹配时，使用轻量嵌入实现完成检索演示。
PILKB_FAKE_EMBEDDING=1

# ===== Embedding =====
# 后端: local (sentence-transformers 本地加载) | api (OpenAI 兼容的 /embeddings 接口)
#
# 换后端 / 换模型等于换向量空间: bge-small-zh 是 512 维, bge-m3 是 1024 维。
# 已有的向量 collection 必须重建, 否则查询会因维度不匹配直接报错。
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# --- EMBEDDING_BACKEND=api 时使用 (示例: 硅基流动) ---
# bge-m3 是 1024 维、8192 token 上下文, 比 bge-small-zh (512 维 / 512 token) 更适合
# 长 chunk —— 后者会把超过 512 token 的部分静默截断, 后半段内容进不了向量表示。
# 注意 api 后端读的是 EMBEDDING_API_MODEL (不是上面的 EMBEDDING_MODEL):
# 两者默认值不同 —— local 用 bge-small-zh 省资源, api 用 bge-m3 拿长上下文。
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=BAAI/bge-m3
# 单次请求最多送几条文本 / 单条文本字符上限 (超长截断)
# EMBEDDING_API_BATCH=16
# EMBEDDING_MAX_CHARS=8000

# ===== Rerank =====
# 后端: local (sentence-transformers CrossEncoder 本地加载)
#     | api (Cohere 风格的 /rerank 接口, 如硅基流动)
#
# 两者输出的分数量纲不同 (本地是原始 logits, 服务端是归一化到 0~1 的
# relevance_score), 但都只用于同一批候选内部的相对排序, 不影响检索结果。
RERANK_BACKEND=local
RERANK_MODEL=BAAI/bge-reranker-base

# --- RERANK_BACKEND=api 时使用 (示例: 硅基流动) ---
# bge-reranker-v2-m3 与本地 bge-reranker-base 是同系列, 但服务端版本更大且
# 支持多语言; 换 api 后端后本机不再需要 torch / sentence-transformers。
# RERANK_API_BASE=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
# 单条候选送进 rerank 前的字符上限 (本地 CrossEncoder 也会按模型 max_length 截断)
# RERANK_API_MAX_CHARS=2000
# RERANK_API_TIMEOUT=60
# 失败重试次数 (仅对 429 / 5xx / 网络错误重试)
# RERANK_API_MAX_RETRIES=3

# ===== Storage =====
# 默认本地 SQLite, 上线换 PostgreSQL
DATABASE_URL=sqlite:///./data/pilkb.db
# DATABASE_URL=postgresql+psycopg2://pilkb:pilkb@postgres:5432/pilkb

REDIS_URL=redis://localhost:6379/0

CHROMA_PERSIST_DIR=./data/chroma
FILE_STORAGE_DIR=./data/uploads
# BM25 倒排索引持久化目录 (落盘为 bm25_{kb_id}.pkl)
BM25_PERSIST_DIR=./data
# chromadb 在部分 Windows + Anaconda Python 下会 ACCESS_VIOLATION, 可临时切 numpy 兜底
VECTOR_STORE_BACKEND=numpy

# 注: 上面这些存储路径 (含 DATABASE_URL 的 sqlite 路径) 若写成相对路径,
# 都会按项目根目录解析, 不再跟随进程的工作目录 (CWD)。这样 Docker WORKDIR、
# systemd 启动方式不同也不会把数据写到意料之外的位置。

# ===== Auth =====
JWT_SECRET=change-me-in-production-please-use-openssl-rand
JWT_ALGORITHM=HS256
# token 有效期 (分钟). 注意字段名必须是 JWT_EXPIRE_MINUTES (对应 config 的 jwt_expire_minutes).
# 之前这里写成 JWT_EXPIRES_MIN, pydantic-settings 不认, 改了静默不生效.
JWT_EXPIRE_MINUTES=1440
# 登出/吊销后旧 token 的最长残留校验时间 (进程内缓存 TTL, 秒; 0 = 每次直查 DB)
# AUTH_TOKEN_CACHE_TTL_SEC=30

# ===== Knowledge Base ACL =====
# 公共只读知识库白名单 (逗号分隔). 这些 kb_id 任何登录用户可读, 不可写入;
# 上传文档时会自动创建并归属当前用户 (私有). 默认含 "default" 以兼容 demo.
PUBLIC_KB_IDS=default

# 管理员用户名白名单 (逗号分隔), 用于公共 kb 的 BM25 索引重建
# (POST /documents/rebuild-bm25)。私有 kb 的 owner 无需在此列。
# 公共 kb 不归任何用户所有, 重建又是全量读 + 落盘的 O(N) 操作, 所以不放给任意访客。
# 留空 = 无人可在界面上重建公共 kb, 只能由运维手工调接口。
# 本地演示可设 ADMIN_USERS=dev-user (dev-token 只在 APP_ENV=dev 颁发, 生产无效)。
ADMIN_USERS=

# ===== CORS =====
# 允许跨域的前端 origin 白名单 (逗号分隔). 严禁 "*" + credentials=True 的写法.
# 默认只允许本地 Next.js 开发服务器; 上线时改成线上域名, 多个用逗号分隔.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== Trusted Proxy =====
# 反代场景下, 只有直连 peer 的 IP 在这份名单里 (逗号分隔; "*" = 全部信任, 仅限
# 本机调试) 才采信 X-Forwarded-For。默认留空 = 完全不信任 XFF, 用直连地址 ——
# 否则客户端可以伪造 XFF 换 IP, 绕过登录爆破锁定与 chat 限流的 ip 维度。
# 例: TRUSTED_PROXIES=172.17.0.1,10.0.0.5
TRUSTED_PROXIES=

# ===== MCP =====
MCP_TRANSPORT=stdio
MCP_SERVER_NAME=pilkb

# ===== Observability (可选) =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Upload =====
# 单文件最大字节数. 超出时返回 413. 默认 25MB.
UPLOAD_MAX_BYTES=26214400

# ===== Agent =====
# agent 模式的引擎: react = tool-calling 循环 (模型自主组织检索词与工具序列,
# 结果不相关时换词重试); router = 旧的一次性路由, 快路径 + 消融对照
# (python tests/run_agent_ablation.py 按此开关对比两引擎).
#AGENT_ENGINE=react
# react 引擎的工具调用轮数上限; 超出后直接用已收集的证据生成答案.
#AGENT_MAX_STEPS=4
# 会话记忆: 带 session_id 的请求按 thread_id="{user}:{session}" 隔离累积对话;
# 关闭后 (或无 session) 与单轮行为一致.
#AGENT_MEMORY_ENABLED=true
# 喂给 LLM 的历史消息条数上限 (含本轮), 更早的留在 checkpoint 不进上下文.
#AGENT_MEMORY_MAX_MESSAGES=20
